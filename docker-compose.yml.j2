services:
  mysql:
    image: mysql:latest
    container_name: cloud1_mysql
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password }}
      MYSQL_DATABASE: {{ mysql_database }}
      MYSQL_USER: {{ mysql_user }}
      MYSQL_PASSWORD: {{ mysql_password }}
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - cloud1_network
    deploy:
      resources:
        limits:
          memory: 768M
        reservations:
          memory: 512M

  wordpress:
    image: wordpress:latest
    container_name: cloud1_wordpress
    restart: always
    environment:
      WORDPRESS_DB_HOST: {{ wordpress_db_host }}
      WORDPRESS_DB_NAME: {{ wordpress_db_name }}
      WORDPRESS_DB_USER: {{ wordpress_db_user }}
      WORDPRESS_DB_PASSWORD: {{ wordpress_db_password }}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', 'https://{{ domain_name }}');
        define('WP_SITEURL', 'https://{{ domain_name }}');
    volumes:
      - wordpress_data:/var/www/html
    depends_on:
      - mysql
    networks:
      - cloud1_network
    deploy:
      resources:
        limits:
          memory: 512M

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: cloud1_phpmyadmin
    restart: always
    environment:
      PMA_HOST: {{ pma_host }}
      PMA_PORT: {{ pma_port }}
      MYSQL_ROOT_PASSWORD: {{ mysql_root_password }}
    depends_on:
      - mysql
    networks:
      - cloud1_network
    deploy:
      resources:
        limits:
          memory: 256M

  nginx:
    image: nginx:latest
    container_name: cloud1_nginx
    restart: always
    ports:
      - "80:80"
      - "443:443"
      - "8080:8080"
    volumes:
      - {{ nginx_config_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - {{ certbot_dir }}/www:/var/www/certbot:ro
    depends_on:
      - wordpress
      - phpmyadmin
    networks:
      - cloud1_network

  certbot:
    image: certbot/certbot:latest
    container_name: cloud1_certbot
    volumes:
      - {{ certbot_dir }}/conf:/etc/letsencrypt
      - {{ certbot_dir }}/www:/var/www/certbot
    entrypoint: "/bin/sh -c 'trap exit TERM; while :; do certbot renew; sleep 12h & wait $${!}; done;'"
    networks:
      - cloud1_network

volumes:
  mysql_data:
    driver: local
  wordpress_data:
    driver: local

networks:
  cloud1_network:
    driver: bridge